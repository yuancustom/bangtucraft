# 模型（值由用户自己填写，不要提交）
CODEBUDDY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://myboot.xyz/v1

# 本机代理：访问 GPT 中转站需要（CodeBuddy 直连）
HTTPS_PROXY=http://127.0.0.1:12000

# 本地工具
GCMP_DWG_TOOLS=E:\Code\gbmp\tools\gcmpDwgTools\bin\VS2022\gcmpDwgTools.exe
UV_EXE=uv

# 原版帮图Mind 数据库（只读快照导入，用于对比）
ORIGINAL_DB=C:\Users\yangxy-q\AppData\Roaming\bangtuMind\data\bangtu.db

# 自建搜索：SearXNG 地址、搜索 MCP 端口、SearXNG 密钥
SEARXNG_URL=http://127.0.0.1:8888
SEARCH_MCP_PORT=8790
SEARXNG_SECRET=

# 可选：服务地址与端口、数据目录、PyPI 镜像
# 默认免登录，内网访问共享同一工作空间。需要独立账号时改为 accounts。
AUTH_MODE=local
# 可指定已有用户 ID 以保留其工作空间；留空时复用最早用户，空库自动创建。
LOCAL_USER_ID=
# 长图纸任务的每用户 Worker V8 堆上限（MiB），需结合宿主机可用内存调整。
AGENT_HEAP_MB=8192
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=data
# PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 帮图云端（可选，仅 Task 15 使用）
BANGTU_API_KEY=
BANGTU_BUDGET_COINS=10
